<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="QuickNV.HikvisionISUPSDK" Version="1.0.3" />
  </ItemGroup>
  <Target Name="CopyIsupNative" AfterTargets="Publish">
    <PropertyGroup>
      <IsupNativeDir>$([System.IO.Path]::Combine($(NuGetPackageRoot), 'quicknv.hikvisionisupsdk.native', '1.0.3', 'runtimes', 'linux-arm64'))/</IsupNativeDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(IsupNativeDir)libHCISUPCMS.so')" Text="libHCISUPCMS.so nao encontrado em $(IsupNativeDir)" />
    <ItemGroup>
      <IsupSo Include="$(IsupNativeDir)*.so" />
      <IsupSo Include="$(IsupNativeDir)*.so.*" />
      <IsupSoCom Include="$(IsupNativeDir)HCAapSDKCom/*.so" />
    </ItemGroup>
    <Copy SourceFiles="@(IsupSo)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(IsupSoCom)" DestinationFolder="$(PublishDir)HCAapSDKCom/" SkipUnchangedFiles="true" />
  </Target>
</Project>
