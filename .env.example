# PostgreSQL 
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# MongoDB 
MONGODB_URI=
MONGODB_DB_NAME=face2go

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudflare R2 (fotos faciais cadastro público / app responsável — presign GET na web escolar)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Origem do Next.js (CORS em produção, quando FACE2GO_RELAX_CORS não está ativo)
FRONTEND_URL=http://localhost:3000

# AWS SES (redefinição de senha / primeiro acesso) — opcional em dev
# Sem essas vars, o link de reset é logado no console do servidor.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_EMAIL=noreply@face2go.com.br


PORT=3001

# Criptografia de senhas dos leitores (64 hex = 32 bytes). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
READER_ENCRYPTION_KEY=

# LPR Intelbras — estudo de correlação snapManager + eventManager (logs estruturados)
# LPR_EVENT_CODES=TrafficJunction
# LPR_EVENT_LOG=1

# API TOTVS IENH (fetch de alunos/responsáveis para integração)
IENH_API_URL=https://instituicaoevangelica132898.rm.cloudtotvs.com.br:8051/api/framework/v1/consultaSQLServer/RealizaConsulta/WS.02
IENH_API_USER=
# Use aspas se a senha contiver # (senão o restante vira comentário no .env)
IENH_API_PASSWORD=

# Seed (`pnpm db:seed`)
SUPER_ADMIN_EMAIL=admin@face2go.local
SUPER_ADMIN_PASSWORD=
