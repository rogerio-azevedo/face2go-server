# Neon / Postgres (pooling para app; unpooled para migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origem do Next.js (CORS em produção, quando FACIEM_RELAX_CORS não está ativo)
FRONTEND_URL=http://localhost:3000
# Teste no celular na LAN com NODE_ENV=production no .env: use FACIEM_RELAX_CORS=1 para aceitar http://192.168.x.x:3000
# FACIEM_RELAX_CORS=1

PORT=3001

# Criptografia de senhas dos leitores (64 hex = 32 bytes). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
READER_ENCRYPTION_KEY=

# Opcional: stream Intelbras eventManager — códigos (padrão All)
# FACIAL_EVENT_CODES=All
# FACIAL_STREAM_VERBOSE=0

# Seed (`pnpm db:seed`)
SUPER_ADMIN_EMAIL=admin@faciem.local
SUPER_ADMIN_PASSWORD=
