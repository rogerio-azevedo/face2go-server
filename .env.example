# Neon / Postgres (pooling para app; unpooled para migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# MongoDB (histórico de acessos faciais / eventos)
# Sem path na URI (...mongodb.net/?) o driver usaria o banco `test`. MONGODB_DB_NAME fixa o nome lógico.
MONGODB_URI=
MONGODB_DB_NAME=face2go

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origem do Next.js (CORS em produção, quando FACE2GO_RELAX_CORS não está ativo)
FRONTEND_URL=http://localhost:3000
# Teste no celular na LAN com NODE_ENV=production no .env: use FACE2GO_RELAX_CORS=1 para aceitar http://192.168.x.x:3000
# FACE2GO_RELAX_CORS=1

PORT=3001

# Criptografia de senhas dos leitores (64 hex = 32 bytes). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
READER_ENCRYPTION_KEY=

# Opcional: stream Intelbras eventManager — códigos (padrão All)
# FACIAL_EVENT_CODES=All
# FACIAL_STREAM_VERBOSE=0

# Seed (`pnpm db:seed`)
SUPER_ADMIN_EMAIL=admin@face2go.local
SUPER_ADMIN_PASSWORD=
