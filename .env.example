# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000

# MongoDB 
MONGODB_URI=
MONGODB_DB_NAME=face2go

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudflare R2 (fotos faciais cadastro público / app responsável — presign GET na web escolar)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Origem do Next.js (CORS em produção, quando FACE2GO_RELAX_CORS não está ativo)
FRONTEND_URL=http://localhost:3000

# Host público que o leitor Intelbras alcança no POST (produção)
# API_URL=https://api.face2go.com.br
# Corta snapManager facial Intelbras depois de validar o POST no UUID
# FACIAL_INTELBRAS_SKIP_STREAM=1
# Rollback: reabre a stream facial Intelbras
# FACIAL_INTELBRAS_USE_STREAM=1

# E-mail transacional (redefinição de senha) — opcional em dev
# Sem credenciais do provedor escolhido, o link de reset é logado no console.
# EMAIL_PROVIDER=smtp   # smtp (Zoho) ou ses (AWS)

# SMTP / Zoho — quando EMAIL_PROVIDER=smtp
# SMTP_HOST=smtppro.zoho.com
# SMTP_PORT=465
# SMTP_USER=noreply@face2go.com.br
# SMTP_PASS=
# SMTP_FROM_EMAIL=noreply@face2go.com.br

# AWS SES — quando EMAIL_PROVIDER=ses
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_EMAIL=noreply@face2go.com.br


PORT=3001

# Debounce (ms) antes de notificar o admin do cliente que um leitor ficou offline (padrão: 90000)
# READER_OFFLINE_NOTIFY_DEBOUNCE_MS=90000

# Criptografia de senhas dos leitores (64 hex = 32 bytes). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
READER_ENCRYPTION_KEY=

# LPR Intelbras — estudo de correlação snapManager + eventManager (logs estruturados)
# LPR_EVENT_CODES=TrafficJunction
# LPR_EVENT_LOG=1

# API TOTVS IENH (fetch de alunos/responsáveis para integração)
IENH_API_URL=https://instituicaoevangelica132898.rm.cloudtotvs.com.br:8051/api/framework/v1/consultaSQLServer/RealizaConsulta/WS.02
IENH_API_USER=
# Use aspas se a senha contiver # (senão o restante vira comentário no .env)
IENH_API_PASSWORD=

# HERE API — geocoding de endereços (proxy backend; opcional em dev)
HERE_API_KEY=
# HERE_DISCOVER_BASE_URL=https://discover.search.hereapi.com/v1
# HERE_GEOCODE_BASE_URL=https://geocode.search.hereapi.com/v1

# Seed (`pnpm db:seed`)
SUPER_ADMIN_EMAIL=admin@face2go.local
SUPER_ADMIN_PASSWORD=
